# Kopiraj u .env:  cp .env.example .env   i upiši svoje podatke.
# .env se NIKAD ne šalje na GitHub (nalazi se u .gitignore).

# --- OANDA ---
# practice = demo račun (virtualni novac), live = PRAVI novac
OANDA_ENV=practice
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
# Za live mora biti i ovo (svjesna potvrda):
# I_UNDERSTAND_REAL_MONEY=da

# --- Telegram (obavijesti i komande s mobitela) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trgovanje ---
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,EUR_GBP
GRANULARITY=H1
# 0.01 = 1% računa rizika po trejdu (~5 EUR na 500 EUR)
RISK_PER_TRADE=0.01
MAX_OPEN_TRADES=2
# 0.03 = stani za taj dan nakon -3%
DAILY_LOSS_LIMIT=0.03
MAX_SPREAD_PIPS=2.5
# ESMA limit za glavne parove u EU je 1:30
LEVERAGE=30
MAX_MARGIN_USE=0.5
# DRY_RUN=true -> samo javlja signale, ne šalje naloge
DRY_RUN=false

# --- Strategija (napredno) ---
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
SL_ATR=1.5
TP_ATR=3.0
