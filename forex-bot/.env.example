# Kopiraj u .env:  cp .env.example .env   i upiši svoje podatke.
# .env se NIKAD ne šalje na GitHub (nalazi se u .gitignore).

# binance (kripto, spot) ili oanda (forex)
BROKER=binance

# --- Binance ---
# true = Testnet (virtualni novac, ključevi s testnet.binance.vision)
# false = PRAVI račun (ključevi s binance.com) + mora biti I_UNDERSTAND_REAL_MONEY=da
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet: BTCUSDT,ETHUSDT   |   Pravi račun u EU: BTCEUR,ETHEUR (ili BTCUSDC,ETHUSDC)
# Svi parovi moraju imati istu kotnu valutu (EUR, USDT ili USDC).
# SYMBOLS=BTCUSDT,ETHUSDT
# Binance provizija po strani (0.001 = 0.1%)
FEE_RATE=0.001
MAX_SPREAD_PCT=0.15
# najviše 45% kapitala u jednoj poziciji
MAX_POSITION_FRACTION=0.45

# --- Strategija ---
# grid   = kupi nisko / prodaj visoko s malim nalozima (preporuka za početak)
# signal = EMA crossover, nekoliko većih trejdova mjesečno
STRATEGY=grid

# --- Grid postavke ---
# Par: ETHUSDC (pravi račun u EU), ETHUSDT (testnet), ili npr. ETHEUR / BTCEUR
GRID_SYMBOL=ETHUSDC
# Raspon ±8% oko trenutne cijene (ili ručno GRID_LOWER i GRID_UPPER)
GRID_RANGE_PCT=8
# GRID_LOWER=
# GRID_UPPER=
# Broj razina; 8 razina na ±8% = ~2% razmaka (provizije su ~0.2% po krugu)
GRID_LEVELS=8
# Iznos po nalogu (Binance minimum je ~5)
GRID_ORDER_QUOTE=6

# --- Telegram (obavijesti i komande s mobitela) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trgovanje (zajedničko) ---
# Binance zadano H4 (manje trejdova = manje provizija), OANDA zadano H1
# GRANULARITY=H4
# 0.01 = 1% kapitala rizika po trejdu (~5 EUR na 500 EUR)
RISK_PER_TRADE=0.01
MAX_OPEN_TRADES=2
# 0.03 = stani za taj dan nakon -3%
DAILY_LOSS_LIMIT=0.03
# DRY_RUN=true -> samo javlja signale, ne šalje naloge
DRY_RUN=false
# I_UNDERSTAND_REAL_MONEY=da

# --- Strategija (napredno) ---
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
SL_ATR=1.5
TP_ATR=3.0

# --- OANDA (samo ako je BROKER=oanda) ---
OANDA_ENV=practice
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,EUR_GBP
MAX_SPREAD_PIPS=2.5
LEVERAGE=30
MAX_MARGIN_USE=0.5
